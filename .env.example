# OCR Provider: "openai" or "gemini"
OCR_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY="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"

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model for Schema Extraction
# Options for OpenAI: gpt-4o, gpt-4-turbo, gpt-4
# Options for Gemini: gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=gpt-4o

# ===========================================
# Frappe ERP Integration
# ===========================================

FRAPPE_URL=https://your-frappe-instance.com
FRAPPE_API_KEY=your_frappe_api_key
FRAPPE_API_SECRET=your_frappe_api_secret

# ===========================================
# Application Settings
# ===========================================

# API Settings
API_PREFIX=/api/v1
DEBUG=false

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
